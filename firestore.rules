rules_version = '2';

// RedlineStudio security rules — replaces the expiring test-mode rules.
// PASTE THIS ENTIRE FILE into Firebase console → Firestore Database → Rules
// → Publish. Deploy the matching site update (uid stamps) FIRST.
//
// The philosophy, matching the site: everything is public to READ; writing is
// tied to the Firebase login (Opus's auth v2). What these rules guarantee:
//   · nobody can edit or delete another player's games, models, comments,
//     threads, posts, profile or page
//   · identity is frozen: username and login binding can never be rewritten
//   · other players can only ever ADD coins to your account, never take
//   · new accounts start with exactly 100 coins; new machines with an empty pool
//   · the arcade floor (seats) is shared by design, login required to write
//   · COINS CANNOT BE MINTED: a balance can only rise by the daily +100
//     (server-checked date), by another player paying you, or by coins that
//     verifiably LEFT a machine's pool in the same transaction (conservation,
//     enforced with getAfter). Every coin traces to a legitimate source.
// Known, accepted limit of a serverless design: a technical user could still
// cheat the ODDS against a machine's funded pool (coins conserve — it's
// bounded by what the pool holds and visible to everyone). Closing that
// needs server-side spins (Cloud Functions) someday.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // MODERATORS: a doc in /mods keyed by the login's uid. That collection is
    // console-only (no client can write it), so nobody can promote themselves.
    function isMod() {
      return signedIn()
        && exists(/databases/$(database)/documents/mods/$(request.auth.uid));
    }
    function utcToday() {
      return string(request.time.year()) + '-' + string(request.time.month()) + '-' + string(request.time.day());
    }

    // ------------------------------------------------------------- users
    match /users/{userId} {
      allow read: if true;

      // new accounts: bound to this login, standard starting coins
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 1
        && request.resource.data.username.size() <= 10
        && request.resource.data.coins == 100;

      allow update: if signedIn() && (
        // a v1 account upgrading itself: no uid yet, gains this login's
        (!('uid' in resource.data)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.username == resource.data.username)
        // the account owner — identity frozen, and coins NEVER self-minted:
        || (resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.username == resource.data.username
          && (
            // spending or neutral — a balance may always go down or stay
            request.resource.data.get('coins', 0) <= resource.data.get('coins', 0)
            // the daily claim: exactly +100, dated TODAY (server clock), once
            || (changedKeys().hasOnly(['coins', 'lastDaily'])
                && request.resource.data.get('coins', 0) == resource.data.get('coins', 0) + 100
                && request.resource.data.lastDaily == utcToday()
                && resource.data.get('lastDaily', '') != utcToday())
            // a casino payout: every coin gained here verifiably LEFT the
            // machine's pool in this same transaction — conservation
            || ('lastSpin' in request.resource.data
                && changedKeys().hasOnly(['coins', 'lastSpin'])
                && request.resource.data.lastSpin.game is string
                && getAfter(/databases/$(database)/documents/games/$(request.resource.data.lastSpin.game)).data.pool
                   == get(/databases/$(database)/documents/games/$(request.resource.data.lastSpin.game)).data.pool
                      - (request.resource.data.get('coins', 0) - resource.data.get('coins', 0)))
          ))
        // everyone else: paying coins IN and voting only — coins only go up
        || (resource.data.get('uid', '') != request.auth.uid
            && changedKeys().hasOnly(['coins', 'votes', 'likes', 'dislikes'])
            && request.resource.data.get('coins', 0) >= resource.data.get('coins', 0))
      )
      // the age bracket is declared ONCE — after that, frozen forever
      && (!('ageBracket' in resource.data)
          || request.resource.data.get('ageBracket', '') == resource.data.ageBracket);

      // the owner may erase their own account (the ⚙ Account delete button) —
      // and a moderator may erase an account's data (its login is then removed
      // in the Firebase console: Authentication → that user → delete)
      allow delete: if isMod() || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
    }

    // ------------------------------------------------------------- games
    match /games/{gameId} {
      allow read: if true;

      // publishing binds the game to this login; machines start with ◎0 pools
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.get('pool', 0) == 0;

      allow update: if
        // the play counter: anyone, even logged out
        changedKeys().hasOnly(['plays'])
        // a moderator may unlist or re-rate — and touch NOTHING else
        || (isMod() && changedKeys().hasOnly(['unlisted', 'rating']))
        || (signedIn() && (
          // the owner — everything EXCEPT conjuring pool coins
          (resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.get('pool', 0) == resource.data.get('pool', 0))
          // a pre-rules game being saved: it gets stamped with this login
          || (!('ownerUid' in resource.data)
              && request.resource.data.ownerUid == request.auth.uid
              && request.resource.data.get('pool', 0) == resource.data.get('pool', 0))
          // voting
          || changedKeys().hasOnly(['votes', 'likes', 'dislikes'])
          // POOL MOVES (spins, funding, collecting) — conservation only:
          // every coin entering or leaving this pool verifiably leaves or
          // enters the named player's balance in this same transaction
          || ('lastSpin' in request.resource.data
              && changedKeys().hasOnly(['pool', 'lastSpin'])
              && request.resource.data.get('pool', 0) >= 0
              && request.resource.data.lastSpin.user is string
              && getAfter(/databases/$(database)/documents/users/$(request.resource.data.lastSpin.user)).data.coins
                 == get(/databases/$(database)/documents/users/$(request.resource.data.lastSpin.user)).data.coins
                    + (resource.data.get('pool', 0) - request.resource.data.get('pool', 0)))
        ));

      allow delete: if isMod() || (signedIn()
        && (resource.data.ownerUid == request.auth.uid
            || !('ownerUid' in resource.data)));
    }

    // ------------------------------------------------------------- models
    match /models/{modelId} {
      allow read: if true;

      // saving a model — and buying one, which copies it into YOUR inventory
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if signedIn() && (
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid)
        || (!('ownerUid' in resource.data)
            && request.resource.data.ownerUid == request.auth.uid)
        || changedKeys().hasOnly(['votes', 'likes', 'dislikes'])
      );

      allow delete: if isMod() || (signedIn()
        && (resource.data.ownerUid == request.auth.uid
            || !('ownerUid' in resource.data)));
    }

    // ---------------------------------------------------------- comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 300;
      allow update: if false;
      allow delete: if isMod() || (signedIn()
        && (resource.data.authorUid == request.auth.uid
            || !('authorUid' in resource.data)));
    }

    // ------------------------------------------------------------ forums
    match /threads/{threadId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if signedIn() && (
        changedKeys().hasOnly(['replies', 'lastAt'])   // reply counters
        || resource.data.authorUid == request.auth.uid
        || !('authorUid' in resource.data)
      );
      allow delete: if isMod() || (signedIn()
        && (resource.data.authorUid == request.auth.uid
            || !('authorUid' in resource.data)));
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000;
      allow update: if false;
      // the post's author — or the thread's author cleaning their thread
      allow delete: if isMod() || (signedIn() && (
        resource.data.authorUid == request.auth.uid
        || !('authorUid' in resource.data)
        || get(/databases/$(database)/documents/threads/$(resource.data.thread)).data.authorUid == request.auth.uid
      ));
    }

    // -------------------------------------------- the arcade floor: seats
    // Shared by design: sitting, lining up, chatting, kicking all rewrite
    // this doc. Login required; the floor's own heartbeat rules keep order.
    match /seats/{gameId} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if false;
    }

    // ------------------------------------------------ high-score tables
    // One row per player per game — their personal best. The row's id must
    // be the writer's OWN account doc (so one player = one slot), the name
    // on it must be their real username, and a best can only improve.
    // (Like the casino odds, the score VALUE is reported by the player's
    // browser — but nobody can ever touch anyone else's row.)
    match /scores/{gameId}/entries/{entryId} {
      allow read: if true;
      allow create: if signedIn()
        && get(/databases/$(database)/documents/users/$(entryId)).data.uid == request.auth.uid
        && request.resource.data.user == get(/databases/$(database)/documents/users/$(entryId)).data.username
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is number
        && request.resource.data.score >= 0;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.user == resource.data.user
        && request.resource.data.score is number
        && request.resource.data.score > resource.data.score;
      allow delete: if isMod();   // striking a cheated score
    }

    // --------------------------------------- one account, one machine
    match /present/{presenceId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && resource.data.get('uid', request.auth.uid) == request.auth.uid;
      allow delete: if false;
    }

    // ---------------------------------------------------------- moderators
    // Doc id = a Firebase Auth uid. Created ONLY in the Firebase console.
    match /mods/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;   // "am I a mod?"
      allow create, update, delete: if false;
    }

    // ------------------------------------------------------------- reports
    // the ⚑ button: anyone signed in can flag a game for moderation.
    // Reports are write-only from the site — the moderator reads them in the
    // Firebase console. Nobody can read, edit or scrub them from out here.
    match /reports/{reportId} {
      allow read: if isMod();
      allow create: if signedIn()
        && request.resource.data.by is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 300
        && request.resource.data.game is string;
      allow update: if false;
      allow delete: if isMod();   // resolving a report
    }

    // everything else: denied
  }
}
