rules_version = '2';

// RedlineStudio security rules — replaces the expiring test-mode rules.
// PASTE THIS ENTIRE FILE into Firebase console → Firestore Database → Rules
// → Publish. Deploy the matching site update (uid stamps) FIRST.
//
// The philosophy, matching the site: everything is public to READ; writing is
// tied to the Firebase login (Opus's auth v2). What these rules guarantee:
//   · nobody can edit or delete another player's games, models, comments,
//     threads, posts, profile or page
//   · identity is frozen: username and login binding can never be rewritten
//   · other players can only ever ADD coins to your account, never take
//   · new accounts start with exactly 100 coins; new machines with an empty pool
//   · the arcade floor (seats) is shared by design, login required to write
//   · COINS CANNOT BE MINTED: a balance can only rise by the daily +100
//     (server-checked date), by another player paying you, or by coins that
//     verifiably LEFT a machine's pool in the same transaction (conservation,
//     enforced with getAfter). Every coin traces to a legitimate source.
// Known, accepted limit of a serverless design: a technical user could still
// cheat the ODDS against a machine's funded pool (coins conserve — it's
// bounded by what the pool holds and visible to everyone). Closing that
// needs server-side spins (Cloud Functions) someday.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // MODERATORS: a doc in /mods keyed by the login's uid. That collection is
    // console-only (no client can write it), so nobody can promote themselves.
    function isMod() {
      return signedIn()
        && exists(/databases/$(database)/documents/mods/$(request.auth.uid));
    }
    function utcToday() {
      return string(request.time.year()) + '-' + string(request.time.month()) + '-' + string(request.time.day());
    }
    // TYPING WHERE OTHERS READ IT (comments, forum threads and posts) is for
    // a declared 13+ only. The bracket lives in the PRIVATE /ages/{uid} doc.
    function canSpeak() {
      return signedIn()
        && exists(/databases/$(database)/documents/ages/$(request.auth.uid))
        && get(/databases/$(database)/documents/ages/$(request.auth.uid)).data.ageBracket in ['13', '16', '18'];
    }

    // ------------------------------------------------------------- users
    match /users/{userId} {
      allow read: if true;

      // new accounts: bound to this login, standard starting coins
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 1
        && request.resource.data.username.size() <= 10
        && request.resource.data.coins == 100;

      allow update: if signedIn() && (
        // a v1 account upgrading itself: no uid yet, gains this login's
        (!('uid' in resource.data)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.username == resource.data.username)
        // the account owner — identity frozen, and coins NEVER self-minted:
        || (resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.username == resource.data.username
          && (
            // spending or neutral — a balance may always go down or stay
            request.resource.data.get('coins', 0) <= resource.data.get('coins', 0)
            // the daily claim: exactly +100, dated TODAY (server clock), once
            || (changedKeys().hasOnly(['coins', 'lastDaily'])
                && request.resource.data.get('coins', 0) == resource.data.get('coins', 0) + 100
                && request.resource.data.lastDaily == utcToday()
                && resource.data.get('lastDaily', '') != utcToday())
            // a casino payout: every coin gained here verifiably LEFT the
            // machine's pool in this same transaction — conservation
            || ('lastSpin' in request.resource.data
                && changedKeys().hasOnly(['coins', 'lastSpin'])
                && request.resource.data.lastSpin.game is string
                && getAfter(/databases/$(database)/documents/games/$(request.resource.data.lastSpin.game)).data.pool
                   == get(/databases/$(database)/documents/games/$(request.resource.data.lastSpin.game)).data.pool
                      - (request.resource.data.get('coins', 0) - resource.data.get('coins', 0)))
          ))
        // everyone else: paying coins IN and voting only — coins only go up
        || (resource.data.get('uid', '') != request.auth.uid
            && changedKeys().hasOnly(['coins', 'votes', 'likes', 'dislikes'])
            && request.resource.data.get('coins', 0) >= resource.data.get('coins', 0))
        // a moderator running the one-time bracket migration: this touch may
        // move ONLY the ageBracket field (the conditions below pin the how)
        || (isMod() && changedKeys().hasOnly(['ageBracket']))
      )
      // THE AGE BRACKET IS PRIVATE NOW (/ages/{uid}). The public record may
      // never gain one; an old public copy stays frozen until its owner moves
      // it out — allowed only when the private copy (same batch) matches.
      && (
        (!('ageBracket' in resource.data) && !('ageBracket' in request.resource.data))
        || ('ageBracket' in resource.data
            && request.resource.data.get('ageBracket', '') == resource.data.ageBracket)
        || ('ageBracket' in resource.data
            && !('ageBracket' in request.resource.data)
            && getAfter(/databases/$(database)/documents/ages/$(request.auth.uid)).data.ageBracket == resource.data.ageBracket)
        // …or a MODERATOR moves it for them (the one-time migration): same
        // conservation — the private copy written in this same batch must
        // match the public one being removed, keyed by the ACCOUNT's uid
        || (isMod()
            && 'ageBracket' in resource.data
            && !('ageBracket' in request.resource.data)
            && getAfter(/databases/$(database)/documents/ages/$(resource.data.uid)).data.ageBracket == resource.data.ageBracket)
      );

      // the owner may erase their own account (the ⚙ Account delete button) —
      // and a moderator may erase an account's data (its login is then removed
      // in the Firebase console: Authentication → that user → delete)
      allow delete: if isMod() || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
    }

    // ------------------------------------------------------------- games
    match /games/{gameId} {
      allow read: if true;

      // publishing binds the game to this login; machines start with ◎0 pools
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.get('pool', 0) == 0;

      allow update: if
        // the play counter: anyone, even logged out
        changedKeys().hasOnly(['plays'])
        // a moderator may unlist or re-rate — and touch NOTHING else
        || (isMod() && changedKeys().hasOnly(['unlisted', 'rating']))
        || (signedIn() && (
          // the owner — everything EXCEPT conjuring pool coins
          (resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.get('pool', 0) == resource.data.get('pool', 0))
          // a pre-rules game being saved: it gets stamped with this login
          || (!('ownerUid' in resource.data)
              && request.resource.data.ownerUid == request.auth.uid
              && request.resource.data.get('pool', 0) == resource.data.get('pool', 0))
          // voting
          || changedKeys().hasOnly(['votes', 'likes', 'dislikes'])
          // POOL MOVES (spins, funding, collecting) — conservation only:
          // every coin entering or leaving this pool verifiably leaves or
          // enters the named player's balance in this same transaction
          || ('lastSpin' in request.resource.data
              && changedKeys().hasOnly(['pool', 'lastSpin'])
              && request.resource.data.get('pool', 0) >= 0
              && request.resource.data.lastSpin.user is string
              && getAfter(/databases/$(database)/documents/users/$(request.resource.data.lastSpin.user)).data.coins
                 == get(/databases/$(database)/documents/users/$(request.resource.data.lastSpin.user)).data.coins
                    + (resource.data.get('pool', 0) - request.resource.data.get('pool', 0)))
        ));

      allow delete: if isMod() || (signedIn()
        && (resource.data.ownerUid == request.auth.uid
            || !('ownerUid' in resource.data)));
    }

    // ------------------------------------------------------------- cards
    // The LIGHT mirror of /games that list pages read (one doc per game,
    // same id). It never holds the game itself — just what a card shows —
    // so phones load the arcade instantly. Writes follow the game's owner.
    match /cards/{gameId} {
      allow read: if true;

      // created in the same batch as its game (getAfter sees the new game),
      // by the owner republishing an old game, or by a mod (the backfill)
      allow create: if isMod() || (signedIn()
        && getAfter(/databases/$(database)/documents/games/$(gameId)).data.ownerUid == request.auth.uid);

      allow update: if
        // the play counter: anyone, even logged out (same as games)
        changedKeys().hasOnly(['plays'])
        // a moderator mirrors unlist/re-rate — and touches NOTHING else
        || (isMod() && changedKeys().hasOnly(['unlisted', 'rating']))
        || (signedIn() && (
          // vote and pool mirrors — counters only, by any signed-in player
          changedKeys().hasOnly(['likes', 'dislikes', 'pool'])
          // the owner: everything (getAfter, so a same-batch game update counts)
          || getAfter(/databases/$(database)/documents/games/$(gameId)).data.ownerUid == request.auth.uid
        ));

      // deleted with its game (same batch) by the owner, or by a mod —
      // and a PRE-RULES game (no ownerUid stamp yet) deletes like its game
      // does, or the batch would always half-fail on the card
      allow delete: if isMod() || (signedIn()
        && (get(/databases/$(database)/documents/games/$(gameId)).data.ownerUid == request.auth.uid
            || !('ownerUid' in get(/databases/$(database)/documents/games/$(gameId)).data)));
    }

    // ------------------------------------------------------------- models
    match /models/{modelId} {
      allow read: if true;

      // saving a model — and buying one, which copies it into YOUR inventory
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if signedIn() && (
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid)
        || (!('ownerUid' in resource.data)
            && request.resource.data.ownerUid == request.auth.uid)
        || changedKeys().hasOnly(['votes', 'likes', 'dislikes'])
      );

      allow delete: if isMod() || (signedIn()
        && (resource.data.ownerUid == request.auth.uid
            || !('ownerUid' in resource.data)));
    }

    // ---------------------------------------------------------- comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if canSpeak()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 300;
      allow update: if false;
      allow delete: if isMod() || (signedIn()
        && (resource.data.authorUid == request.auth.uid
            || !('authorUid' in resource.data)));
    }

    // ------------------------------------------------------------ forums
    match /threads/{threadId} {
      allow read: if true;
      allow create: if canSpeak()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if signedIn() && (
        changedKeys().hasOnly(['replies', 'lastAt'])   // reply counters
        || resource.data.authorUid == request.auth.uid
        || !('authorUid' in resource.data)
      );
      allow delete: if isMod() || (signedIn()
        && (resource.data.authorUid == request.auth.uid
            || !('authorUid' in resource.data)));
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if canSpeak()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000;
      allow update: if false;
      // the post's author — or the thread's author cleaning their thread
      allow delete: if isMod() || (signedIn() && (
        resource.data.authorUid == request.auth.uid
        || !('authorUid' in resource.data)
        || get(/databases/$(database)/documents/threads/$(resource.data.thread)).data.authorUid == request.auth.uid
      ));
    }

    // -------------------------------------------- the arcade floor: seats
    // Shared by design: sitting, lining up, chatting, kicking all rewrite
    // this doc. Login required; the floor's own heartbeat rules keep order.
    match /seats/{gameId} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if false;
    }

    // ------------------------------------------------ high-score tables
    // One row per player per game — their personal best. The row's id must
    // be the writer's OWN account doc (so one player = one slot), the name
    // on it must be their real username, and a best can only improve.
    // (Like the casino odds, the score VALUE is reported by the player's
    // browser — but nobody can ever touch anyone else's row.)
    match /scores/{gameId}/entries/{entryId} {
      allow read: if true;
      allow create: if signedIn()
        && get(/databases/$(database)/documents/users/$(entryId)).data.uid == request.auth.uid
        && request.resource.data.user == get(/databases/$(database)/documents/users/$(entryId)).data.username
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is number
        && request.resource.data.score >= 0;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.user == resource.data.user
        && request.resource.data.score is number
        && request.resource.data.score > resource.data.score;
      allow delete: if isMod();   // striking a cheated score
    }

    // --------------------------------------- one account, one machine
    match /present/{presenceId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && (resource.data.get('uid', request.auth.uid) == request.auth.uid
            // the account was recreated: whoever owns users/{id} NOW may
            // reclaim its presence doc (only that account's real owner can)
            || get(/databases/$(database)/documents/users/$(presenceId)).data.get('uid', '') == request.auth.uid);
      // the owner clears it (account deletion) — so a deleted-and-recreated
      // account can never be locked out by its own old presence doc
      allow delete: if isMod() || (signedIn()
        && (resource.data.get('uid', '') == request.auth.uid
            || get(/databases/$(database)/documents/users/$(presenceId)).data.get('uid', '') == request.auth.uid));
    }

    // ------------------------------------------------------ age brackets
    // PRIVATE: one doc per login (id = Firebase Auth uid), readable only by
    // that login. Declared once from ⚙ Account; the owner may erase it when
    // deleting the account. (A technical user could erase and re-declare —
    // the same as making a new account, which honest self-declaration allows.)
    match /ages/{uid} {
      // a mod may read brackets only to run the one-time migration and honor
      // parent requests — the operator can see them in the console anyway
      allow read: if isMod() || (signedIn() && request.auth.uid == uid);
      // an under-13 declaration also stores `grows`: the YYYYMM month the
      // account turns 13 (an integer like 203902 — the MONTH, never the
      // birth date), so the bracket can grow up on its own below
      allow create: if (
          signedIn() && request.auth.uid == uid
          && request.resource.data.ageBracket in ['u13', '13', '16', '18']
          && (
            request.resource.data.keys().hasOnly(['ageBracket'])
            || (request.resource.data.keys().hasOnly(['ageBracket', 'grows'])
                && request.resource.data.ageBracket == 'u13'
                && request.resource.data.grows is int)
          )
        )
        // …or a mod migrating an old PUBLIC bracket into here (the users-doc
        // side of that batch checks the values match; a mod could do this
        // from the console regardless — this just lets Mod Desk do it)
        || (isMod()
            && request.resource.data.keys().hasOnly(['ageBracket'])
            && request.resource.data.ageBracket in ['u13', '13', '16', '18']);
      // GROWING UP is the one allowed change: u13 → 13, by the owner, only
      // once the stored turns-13 month has arrived on the SERVER clock
      allow update: if signedIn() && request.auth.uid == uid
        && resource.data.ageBracket == 'u13'
        && resource.data.get('grows', 999999) <= request.time.year() * 100 + request.time.month()
        && request.resource.data.keys().hasOnly(['ageBracket'])
        && request.resource.data.ageBracket == '13';
      allow delete: if isMod() || (signedIn() && request.auth.uid == uid);
    }

    // ---------------------------------------------------------- moderators
    // Doc id = a Firebase Auth uid. Created ONLY in the Firebase console.
    match /mods/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;   // "am I a mod?"
      allow create, update, delete: if false;
    }

    // ------------------------------------------------------------- reports
    // the ⚑ button: anyone signed in can flag a game for moderation.
    // Reports are write-only from the site — the moderator reads them in the
    // Firebase console. Nobody can read, edit or scrub them from out here.
    match /reports/{reportId} {
      allow read: if isMod();
      allow create: if signedIn()
        && request.resource.data.by is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 300
        && request.resource.data.game is string;
      allow update: if false;
      allow delete: if isMod();   // resolving a report
    }

    // ---------------------------------------------------------- course progress
    // One doc per login (id = Firebase Auth uid): { courses: { crt: <ms>, … } }.
    // Readable by anyone (it's a trophy shelf — future profile badges read it);
    // writable only by its owner, and only in that one shape.
    match /progress/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['courses'])
        && request.resource.data.courses is map;
      allow delete: if isMod() || (signedIn() && request.auth.uid == uid);
    }

    // ------------------------------------------------------------- inbox
    // The contact form (contact.html): privacy requests, parent/guardian
    // requests, appeals, copyright notices. Anyone may write one — INCLUDING
    // logged-out visitors, because a parent needn't have an account — and
    // only moderators can read or clear them. Sizes are capped; that's the
    // whole spam defense a write-only box needs.
    match /inbox/{msgId} {
      allow read: if isMod();
      allow create: if request.resource.data.keys().hasOnly(['topic', 'text', 'contact', 'by', 'at'])
        && request.resource.data.topic is string
        && request.resource.data.topic.size() >= 1
        && request.resource.data.topic.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000
        && request.resource.data.contact is string
        && request.resource.data.contact.size() <= 120
        && request.resource.data.by is string
        && request.resource.data.by.size() <= 20
        && request.resource.data.at is int;
      allow update: if false;
      allow delete: if isMod();
    }

    // everything else: denied
  }
}
